# Copy this file to design.env and change it. Lines starting with # are ignored.

# Who can reach Design: 0.0.0.0 = this computer and the home network (they sign in with the PIN to control). Leave out for this computer only.
DESIGN_HOST=0.0.0.0

# Ruida laser: turn it on and name it (name=address). Close LightBurn first: only one program can talk to the laser.
DESIGN_RUIDA=1
DESIGN_RUIDA_HOSTS=laser=192.168.1.50
# The most power (percent) the server will accept in any job
DESIGN_RUIDA_MAX_POWER=85
# Off until you have tried them once, watching the machine (both were seen from LightBurn, neither has run from here):
#   Home: the head goes to the machine's limits and then to 0, 0.   Z: the Z+ and Z- buttons and Auto focus in the Move window.
# DESIGN_RUIDA_HOME=1
# DESIGN_RUIDA_Z=1

# One PIN for DemonX CNC and Design: the folder where DemonX CNC keeps its data (leave out to give Design its own PIN)
# DESIGN_AUTH_DIR=/home/YOUR-USER-NAME/demonx/data

# USB (GRBL) lasers: only these ports are ever offered. Leave out for none, so a CNC on USB can never be picked as a laser.
# DESIGN_SERIAL_PORTS=/dev/ttyUSB1

# Camera: where DemonX CNC keeps its saved Home Assistant address and token, so they are not entered twice (the camera itself is chosen in Settings, Camera).
# Leave out to enter them in Design instead.
# DESIGN_CNC_DATA=/home/YOUR-USER-NAME/demonx/data

# https: with a certificate and its key the browser offers its real Save As / Open windows from other computers (see the README)
# DESIGN_TLS_CERT=/home/YOUR-USER-NAME/design-cert.pem
# DESIGN_TLS_KEY=/home/YOUR-USER-NAME/design-key.pem

