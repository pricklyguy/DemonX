{
  "name": "demonx-design",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "DemonX Design: 2D vector design proof (shapes, layers, booleans, offsets, DXF/SVG)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5174",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve": "tsx server/src/index.ts",
    "dev:server": "tsx watch server/src/index.ts"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "clipper-lib": "^6.4.2",
    "dxf-parser": "^1.1.2",
    "opentype.js": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
